PORT=8790
# Claude Haiku 4.5 owns typed and spoken conversation logic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TEXT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_VOICE=claude-haiku-4-5-20251001

# Gemini renders Haiku's exact replies as audio; browser speech is the fallback.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# Google OAuth Web Client ID. No client secret is used by this browser flow.
GOOGLE_CLIENT_ID=

# Optional production persistence.
DATABASE_URL=
